{
  "expo": {
    "name": "Mujeres con Proposito",
    "slug": "mujeres-con-proposito",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mcp930",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "org.mcp930.app",
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true,
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "org.mcp930.app",
      "adaptiveIcon": {
        "backgroundColor": "#FCEAE5",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usa Face ID para entrar al panel privado de Mujeres con Propósito sin escribir tu contraseña."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Usa Face ID para entrar al panel privado de Mujeres con Propósito sin escribir tu contraseña."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF7F6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7A2E42",
          "defaultChannel": "reuniones",
          "enableRemoteNotifications": true,
          "sounds": [
            "./assets/sounds/reunion.wav"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-widgets",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app usa tus fotos para subirlas a la galería de Mujeres con Propósito."
        }
      ],
      "expo-sharing",
      [
        "./plugins/with-display-name",
        {
          "displayName": "MCP930"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "9495d153-1df4-4a87-af3c-c427881945b7",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "org.mcp930.app.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.org.mcp930.app"
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "owner": "matmax-consulting"
  }
}
